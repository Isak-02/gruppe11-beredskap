{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Launch (gruppe11-beredskap)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}\\gruppe11-beredskap\\bin\\Debug\\net10.0\\gruppe11-beredskap.dll",
      "args": [],
      "cwd": "${workspaceFolder}\\gruppe11-beredskap",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5179"
      }
    }
  ]
}

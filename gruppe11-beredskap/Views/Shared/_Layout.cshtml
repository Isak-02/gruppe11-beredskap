@using gruppe11_beredskap.Models.Entities
@using Microsoft.AspNetCore.Identity
@inject UserManager<Bruker> UserManager
@{
    // Brukeren som er logget inn (null hvis ingen). Brukes til navnet i profilmenyen.
    var innloggetBruker = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
    var erKoordinator = User.IsInRole(RoleNames.Koordinator);
    var erKriseInnmelder = User.IsInRole(RoleNames.KriseInnmelder);
    var erRessursInnmelder = User.IsInRole(RoleNames.RessursInnmelder);
    var rolleNavn = erKoordinator ? "Koordinator"
        : erKriseInnmelder ? "Krise-innmelder"
        : erRessursInnmelder ? "Ressurs-innmelder"
        : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Kartkrise</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/gruppe11_beredskap.styles.css" asp-append-version="true"/>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.css" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark kk-navbar shadow-sm mb-3">
        <div class="container-fluid">
            <a class="navbar-brand kk-navbar-brand"
               asp-area=""
               asp-controller="Home"
               asp-action="Index">
                <img src="~/images/kartkrise-logo.png"
                     alt="KartKrise"
                     class="kk-navbar-logo" />
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                <!-- Menyen viser bare sidene brukeren har tilgang til -->
                <ul class="navbar-nav flex-grow-1">
                    @if (erKriseInnmelder || erKoordinator)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Behov" asp-action="Registrer">Registrer behov</a>
                        </li>
                    }
                    @if (erRessursInnmelder || erKoordinator)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Ressurs" asp-action="Registrer">Registrer ressurs</a>
                        </li>
                    }
                    @if (erKoordinator)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Ressurs" asp-action="PerFylke">Ressurser per fylke</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Matching" asp-action="Index">Kobling</a>
                        </li>
                    }
                </ul>

               
<!-- Innlogging og profilmeny -->
<div class="ms-lg-auto mt-3 mt-lg-0 d-flex align-items-center gap-2">

    @if (innloggetBruker == null)
    {
        <!-- Innloggingsknapp: går til innloggingskortet på forsiden -->
        <a id="kk-navbar-login"
           asp-controller="Home"
           asp-action="Index"
           asp-fragment="innlogging"
           class="btn kk-login-button">
            Logg inn
        </a>
    }
    else
    {
        <!-- Profilmeny for den som er logget inn -->
        <div id="kk-navbar-profile" class="dropdown">
            <button class="btn kk-login-button dropdown-toggle d-flex align-items-center gap-2"
                    type="button"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">
                <span aria-hidden="true">&#9679;</span>
                Min profil
            </button>

            <ul class="dropdown-menu dropdown-menu-end kk-profile-menu">
                <li class="px-3 py-2">
                    <strong>@innloggetBruker.Navn</strong>
                    <div class="kk-profile-email">@innloggetBruker.Email</div>
                    <div class="kk-profile-email">@rolleNavn</div>
                </li>

                <li><hr class="dropdown-divider"></li>

                <li>
                    <a class="dropdown-item"
                    asp-controller="Account"
                    asp-action="MinProfil">
                        Min profil
                </a>
</li>

                @if (erKriseInnmelder || erKoordinator)
                {
                    <li>
                        <a class="dropdown-item" asp-controller="Behov" asp-action="Mine">
                            Mine behov
                        </a>
                    </li>
                }

                @if (erRessursInnmelder || erKoordinator)
                {
                    <li>
                        <a class="dropdown-item" asp-controller="Ressurs" asp-action="Mine">
                            Mine ressurser
                        </a>
                    </li>
                }

                @if (erKoordinator)
                {
                    <li>
                        <a class="dropdown-item" asp-controller="Behov" asp-action="Oversikt">
                            Alle behov
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" asp-controller="Ressurs" asp-action="Oversikt">
                            Alle ressurser
                        </a>
                    </li>
                }
                <li>
                    <a class="dropdown-item" asp-controller="Account" asp-action="Innstillinger">
                        Innstillinger
                    </a>
                </li>

                <li><hr class="dropdown-divider"></li>

                <li>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="dropdown-item text-danger">
                            Logg ut
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    }
</div>


            </div>
        </div>
    </nav>

</header>
@{
    var isHomePage = ViewContext.RouteData.Values["controller"]?.ToString() == "Home"
                     && ViewContext.RouteData.Values["action"]?.ToString() == "Index";
}

<div class="@(isHomePage ? "container-fluid px-3 px-lg-4" : "container")">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.js"></script>


@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
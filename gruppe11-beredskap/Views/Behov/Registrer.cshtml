@model gruppe11_beredskap.Models.BehovViewModel
@{
    ViewData["Title"] = "Registrer behov";
}

<h1>Registrer behov</h1>

<form asp-action="Registrer" method="post" class="wizard" data-wizard>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <nav class="wizard-progress" data-wizard-progress aria-label="Fremdrift"></nav>
    <p class="wizard-status" data-wizard-status></p>

    <section class="wizard-panel is-active" data-wizard-panel data-wizard-label="Opplysninger">
        <h2 id="steg-opplysninger">Opplysninger</h2>

        <div class="wizard-chunk">
            <div class="wizard-field">
                <label asp-for="TypeBehov" class="form-label"></label>
                <select asp-for="TypeBehov" class="form-select"
                        data-summary="Type"
                        data-step-required="true"
                        data-step-message="Du må velge type behov.">
                    <option value="">Velg type</option>
                    <option>Transport</option>
                    <option>Droneobservasjon</option>
                    <option>Strøm/aggregat</option>
                    <option>Snørydding</option>
                    <option>Sand/grus</option>
                    <option>Maskiner</option>
                    <option>Evakuering</option>
                    <option>Samband</option>
                    <option>Mannskap</option>
                    <option>Lokaler</option>
                </select>
                <span asp-validation-for="TypeBehov" class="text-danger"></span>
            </div>

            <div class="wizard-field">
                <label asp-for="Beskrivelse" class="form-label"></label>
                <textarea asp-for="Beskrivelse" class="form-control" rows="3" placeholder="Beskriv behovet"
                          data-summary="Beskrivelse"
                          data-step-required="true"
                          data-step-message="Du må skrive en beskrivelse av behovet."></textarea>
                <span asp-validation-for="Beskrivelse" class="text-danger"></span>
            </div>

            <div class="wizard-field">
                <span class="form-label" id="prioritet-label">Prioritet</span>
                <div class="wizard-choices" role="radiogroup" aria-labelledby="prioritet-label"
                     data-choice-group
                     data-summary="Prioritet"
                     data-step-required="true"
                     data-step-message="Du må velge prioritet.">
                    <label class="wizard-choice" for="prioritetLav">
                        <input type="radio" name="Prioritet" id="prioritetLav" value="Lav" @(Model.Prioritet == "Lav" ? "checked" : null) />
                        <span class="wizard-choice-dot behov-lav" aria-hidden="true"></span>
                        Lav
                    </label>
                    <label class="wizard-choice" for="prioritetMiddels">
                        <input type="radio" name="Prioritet" id="prioritetMiddels" value="Middels" @(Model.Prioritet == "Middels" ? "checked" : null) />
                        <span class="wizard-choice-dot behov-middels" aria-hidden="true"></span>
                        Middels
                    </label>
                    <label class="wizard-choice" for="prioritetHoy">
                        <input type="radio" name="Prioritet" id="prioritetHoy" value="Høy" @(Model.Prioritet == "Høy" ? "checked" : null) />
                        <span class="wizard-choice-dot behov-hoy" aria-hidden="true"></span>
                        Høy
                    </label>
                </div>
                <span asp-validation-for="Prioritet" class="text-danger"></span>
            </div>
        </div>

        <div class="wizard-chunk">
            <div class="wizard-split">
                <div class="wizard-field">
                    <label class="form-label" for="dato">Dato</label>
                    <input id="dato" class="form-control" type="date" data-dato
                           data-summary="Dato"
                           data-step-required="true"
                           data-step-message="Du må velge dato." />
                </div>
                <div class="wizard-field">
                    <label class="form-label" for="tid">Tid</label>
                    <input id="tid" class="form-control" type="time" step="900" data-tid
                           data-summary="Tid"
                           data-step-required="true"
                           data-step-message="Du må velge klokkeslett." />
                </div>
            </div>
            <input type="hidden" asp-for="Tidspunkt" asp-format="{0:yyyy-MM-ddTHH:mm}" data-tidspunkt />
            <span asp-validation-for="Tidspunkt" class="text-danger"></span>
            <div class="wizard-field wizard-felt-under">
                <label asp-for="Kontaktpunkt" class="form-label"></label>
                <input asp-for="Kontaktpunkt" class="form-control" placeholder="Navn og telefon"
                       data-summary="Kontaktpunkt"
                       data-step-required="true"
                       data-step-message="Du må skrive inn et kontaktpunkt." />
                <span asp-validation-for="Kontaktpunkt" class="text-danger"></span>
            </div>
        </div>
    </section>

    <section class="wizard-panel" data-wizard-panel data-wizard-label="Kart" data-wizard-map="true">
        <h2 id="steg-kart">Hvor på kartet
            <button type="button" class="hjelp" aria-expanded="false" aria-controls="hjelp-kart" aria-label="Hjelp om kartet">?</button>
        </h2>
        <p class="hjelp-tekst" id="hjelp-kart" hidden>Klikk for markør, eller tegn en sirkel.</p>
        <div id="map"></div>
        <input type="hidden" asp-for="Latitude" id="latitude" data-wizard-lat />
        <input type="hidden" asp-for="Longitude" id="longitude" />
        <input type="hidden" asp-for="Radius" id="radius"
               data-step-max="50000"
               data-step-max-message="Sirkelen er for stor. Radius kan være maks 50 000 meter (50 km)." />
        <input type="hidden" asp-for="GeografiskOmrade" id="geografiskOmrade" />
        <p id="valgtStedTekst" class="text-muted mt-2 mb-0">Ingen posisjon valgt ennå</p>
        <span asp-validation-for="Latitude" class="text-danger"></span>
        <span asp-validation-for="Radius" class="text-danger"></span>
    </section>

    <section class="wizard-panel" data-wizard-panel data-wizard-label="Oversikt" data-wizard-summary="true">
        <h2 id="steg-oversikt">Oversikt</h2>
        <dl class="wizard-summary" data-wizard-summary-list></dl>
    </section>

    <div class="wizard-actions">
        <p class="wizard-error text-danger" data-wizard-error hidden></p>
        <div class="wizard-buttons">
            <button type="button" class="btn btn-outline-primary" data-wizard-back hidden>Tilbake</button>
            <button type="button" class="btn btn-primary" data-wizard-next>Neste</button>
            <button type="submit" class="btn btn-primary" data-wizard-submit hidden>Registrer behov</button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        var kart = null;

        function startBehovKart() {
            if (kart) {
                window.setTimeout(function () { kart.invalidateSize(); }, 0);
                return;
            }

            kart = L.map('map').setView([58.1467, 7.9956], 13);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
            }).addTo(kart);

            // Gruppe som holder figuren brukeren har tegnet (markør eller sirkel)
            var tegnedeFigurer = new L.FeatureGroup();
            kart.addLayer(tegnedeFigurer);

            // Norske tekster i verktøylinjen. Må settes før verktøylinjen lages.
            L.drawLocal.draw.toolbar.actions.title = "Avbryt tegning";
            L.drawLocal.draw.toolbar.actions.text = "Avbryt";
            L.drawLocal.draw.toolbar.buttons.marker = "Sett en markør";
            L.drawLocal.draw.toolbar.buttons.circle = "Tegn en sirkel";
            L.drawLocal.draw.handlers.marker.tooltip.start = "Klikk på kartet for å sette markøren.";
            L.drawLocal.draw.handlers.circle.tooltip.start = "Klikk og dra for å tegne en sirkel.";
            L.drawLocal.draw.handlers.circle.radius = "Radius";
            L.drawLocal.draw.handlers.simpleshape.tooltip.end = "Slipp museknappen for å fullføre sirkelen.";
            L.drawLocal.edit.toolbar.actions.save.title = "Lagre endringene";
            L.drawLocal.edit.toolbar.actions.save.text = "Lagre";
            L.drawLocal.edit.toolbar.actions.cancel.title = "Avbryt redigering og forkast endringene";
            L.drawLocal.edit.toolbar.actions.cancel.text = "Avbryt";
            L.drawLocal.edit.toolbar.actions.clearAll.title = "Slett alle figurer";
            L.drawLocal.edit.toolbar.actions.clearAll.text = "Slett alle";
            L.drawLocal.edit.toolbar.buttons.edit = "Rediger";
            L.drawLocal.edit.toolbar.buttons.editDisabled = "Ingenting å redigere";
            L.drawLocal.edit.toolbar.buttons.remove = "Slett";
            L.drawLocal.edit.toolbar.buttons.removeDisabled = "Ingenting å slette";
            L.drawLocal.edit.handlers.edit.tooltip.text = "Dra i figuren for å flytte eller endre den.";
            L.drawLocal.edit.handlers.edit.tooltip.subtext = "Klikk Avbryt for å angre endringene.";
            L.drawLocal.edit.handlers.remove.tooltip.text = "Klikk på figuren for å slette den.";

            // Verktøylinje på kartet: markør, sirkel, rediger og slett
            var tegneverktøy = new L.Control.Draw({
                draw: {
                    polygon: false,
                    polyline: false,
                    rectangle: false,
                    circlemarker: false,
                    circle: true,
                    marker: true
                },
                edit: {
                    featureGroup: tegnedeFigurer,
                    remove: true
                }
            });
            kart.addControl(tegneverktøy);

            var latInput = document.getElementById('latitude');

            function varsleSkjema() {
                latInput.dispatchEvent(new Event("input", { bubbles: true }));
            }

            // Fyller skjemafeltene med posisjonen til figuren (markør eller sirkel)
            function oppdaterPosisjon(layer) {
                var latlng = layer.getLatLng();
                var lat = latlng.lat;
                var lng = latlng.lng;
                var tekst = "Valgt posisjon: " + lat.toFixed(5) + ", " + lng.toFixed(5);

                latInput.value = lat;
                document.getElementById('longitude').value = lng;
                document.getElementById('geografiskOmrade').value = lat.toFixed(5) + ", " + lng.toFixed(5);

                // Bare sirkelen har radius. For en markør tømmes radiusfeltet.
                if (layer instanceof L.Circle) {
                    var radius = Math.round(layer.getRadius());
                    document.getElementById('radius').value = radius;
                    tekst = tekst + " (radius " + radius + " meter)";
                } else {
                    document.getElementById('radius').value = '';
                }

                var sted = document.getElementById('valgtStedTekst');
                sted.textContent = tekst;
                sted.classList.remove('text-muted');
                sted.classList.add('text-success');
                varsleSkjema();
            }

            // Tømmer skjemafeltene når figuren slettes
            function tomPosisjon() {
                latInput.value = '';
                document.getElementById('longitude').value = '';
                document.getElementById('radius').value = '';
                document.getElementById('geografiskOmrade').value = '';

                var sted = document.getElementById('valgtStedTekst');
                sted.textContent = "Ingen posisjon valgt ennå";
                sted.classList.remove('text-success');
                sted.classList.add('text-muted');
                varsleSkjema();
            }

            // Ny figur tegnet. Bare én figur om gangen, så den forrige fjernes først.
            kart.on('draw:created', function (e) {
                var layer = e.layer;
                tegnedeFigurer.clearLayers();
                tegnedeFigurer.addLayer(layer);
                oppdaterPosisjon(layer);
            });

            // Figuren er flyttet eller fått ny størrelse med rediger-verktøyet
            kart.on('draw:edited', function (e) {
                e.layers.eachLayer(function (layer) {
                    oppdaterPosisjon(layer);
                });
            });

            // Figuren er slettet med slett-verktøyet
            kart.on('draw:deleted', function () {
                tomPosisjon();
            });

            // Ved valideringsfeil kommer siden tilbake med posisjonen i de skjulte feltene.
            // Da tegnes figuren på kartet igjen, slik at brukeren ser den og kan endre eller slette den.
            var lagretLat = latInput.value;
            var lagretLng = document.getElementById('longitude').value;
            var lagretRadius = document.getElementById('radius').value;

            if (lagretLat && lagretLng) {
                var lagretFigur = lagretRadius
                    ? L.circle([Number(lagretLat), Number(lagretLng)], { radius: Number(lagretRadius) })
                    : L.marker([Number(lagretLat), Number(lagretLng)]);

                tegnedeFigurer.addLayer(lagretFigur);
                oppdaterPosisjon(lagretFigur);
                kart.setView([Number(lagretLat), Number(lagretLng)], kart.getZoom());
            }

            window.addEventListener("resize", function () {
                kart.invalidateSize();
            });

            window.setTimeout(function () { kart.invalidateSize(); }, 0);
            window.setTimeout(function () { kart.invalidateSize(); }, 200);
        }

        var skjema = document.querySelector("[data-wizard]");
        skjema.addEventListener("wizard:shown", function (e) {
            if (e.target.querySelector("#map")) startBehovKart();
        });
        if (document.querySelector(".wizard-panel.is-active #map")) startBehovKart();
    </script>
}

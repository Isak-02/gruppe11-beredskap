
@{
    ViewData["Title"] = "Min profil";
}

<style>
    .profile-page {
        padding: 8px 0 40px;
    }

    .profile-card {
        background: white;
        border-radius: 10px;
        padding: 28px;
        margin-bottom: 26px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    }

    .profile-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .profile-user {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .profile-avatar {
        width: 84px;
        height: 84px;
        background: #e3efd3;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .profile-title {
        font-size: 42px;
        margin: 0;
    }

    .profile-subtitle {
        color: #555;
        margin: 4px 0 8px;
    }

    .profile-role {
        display: inline-block;
        background: #198754;
        color: white;
        padding: 3px 10px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: bold;
    }

    .profile-section-title {
        font-size: 30px;
        margin: 28px 0 18px;
    }

    .profile-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
    }

    .profile-stat h3 {
        font-size: 23px;
        margin: 18px 0 24px;
    }

    .profile-stat-number {
        font-size: 30px;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .profile-stat p {
        color: #555;
        margin: 0;
    }

    .profile-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
        margin-top: 20px;
    }

    .profile-info-label {
        color: #666;
        margin-bottom: 3px;
    }

    .profile-info-value {
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    @@media (max-width: 768px) {
        .profile-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .profile-stats,
        .profile-info-grid {
            grid-template-columns: 1fr;
        }

        .profile-title {
            font-size: 32px;
        }
    }
</style>

<div class="profile-page">

    <!-- Profiloverskrift -->
    <div class="profile-card profile-header">
        <div class="profile-user">
            <div class="profile-avatar"></div>

            <div>
                <h1 class="profile-title">Min profil</h1>
                <p class="profile-subtitle">
                    Din personlige oversikt i KartKrise
                </p>
                <span class="profile-role">@ViewBag.Rolle</span>
            </div>
        </div>

        <a asp-controller="Account"
           asp-action="Innstillinger"
           class="btn btn-outline-success">
            Innstillinger
        </a>
    </div>

    <!-- Min aktivitet -->
    <h2 class="profile-section-title">Min aktivitet</h2>

    <div class="profile-stats">

        <div class="profile-card profile-stat">
            <h3>Mine behov</h3>
            <div class="profile-stat-number">—</div>
            <p>Antall registrerte behov</p>
        </div>

        <div class="profile-card profile-stat">
            <h3>Mine ressurser</h3>
            <div class="profile-stat-number">—</div>
            <p>Antall registrerte ressurser</p>
        </div>

        <div class="profile-card profile-stat">
            <h3>Aktive registreringer</h3>
            <div class="profile-stat-number">—</div>
            <p>Registreringer som fortsatt er aktive</p>
        </div>

    </div>

    <!-- Personlig informasjon -->
    <div class="profile-card">
        <h2>Personlig informasjon</h2>
        <hr />

        <div class="profile-info-grid">

            <div>
                <div class="profile-info-label">Fullt navn</div>
                <div class="profile-info-value">
                    @(ViewBag.Navn ?? "Ikke registrert")
                </div>
            </div>

            <div>
                <div class="profile-info-label">E-postadresse</div>
                <div class="profile-info-value">
                    @(ViewBag.Epost ?? "Ikke registrert")
                </div>
            </div>

            <div>
                <div class="profile-info-label">Telefonnummer</div>
                <div class="profile-info-value">
                    @(ViewBag.Telefon ?? "Ikke registrert")
                </div>
            </div>

            <div>
                <div class="profile-info-label">Brukerrolle</div>
                <div class="profile-info-value">
                    @ViewBag.Rolle
                </div>
            </div>

        </div>
    </div>

    <!-- Siste registreringer -->
    <div class="profile-card">
        <h2>Mine siste registreringer</h2>
        <hr />
        <p class="text-muted">
            Her vil dine siste behov og ressurser vises.
        </p>
    </div>

</div>

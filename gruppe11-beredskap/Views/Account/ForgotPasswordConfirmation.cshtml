@{
    ViewData["Title"] = "Sjekk e-posten din";
}

<section class="kk-login-section">
    <div class="kk-login-card">

        <div class="kk-login-heading">
            <h2>Sjekk e-posten din</h2>
            <p>Hvis det finnes en bruker med denne e-postadressen, er det sendt en lenke for å lage nytt passord.</p>
        </div>

        <div class="kk-login-footer">
            <p><a asp-action="Login">Tilbake til innlogging</a></p>
        </div>

    </div>
</section>

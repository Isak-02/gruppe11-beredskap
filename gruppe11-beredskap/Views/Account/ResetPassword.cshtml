@model TilbakestillPassordViewModel
@{
    ViewData["Title"] = "Lag nytt passord";
}

<section class="kk-login-section">
    <div class="kk-login-card">

        <div class="kk-login-heading">
            <h2>Lag nytt passord</h2>
        </div>

        <form class="kk-login-form" asp-action="ResetPassword" method="post">
            <input asp-for="Epost" type="hidden" />
            <input asp-for="Kode" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Passord" class="form-label"></label>
                <input asp-for="Passord" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Passord" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="BekreftPassord" class="form-label"></label>
                <input asp-for="BekreftPassord" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="BekreftPassord" class="text-danger"></span>
            </div>

            <button type="submit" class="kk-login-submit">
                Lagre nytt passord
            </button>
        </form>

    </div>
</section>

@model GlemtPassordViewModel
@{
    ViewData["Title"] = "Glemt passord";
}

<section class="kk-login-section">
    <div class="kk-login-card">

        <div class="kk-login-heading">
            <h2>Glemt passord</h2>
            <p>Skriv inn e-postadressen din, så sender vi en lenke for å lage nytt passord.</p>
        </div>

        <form class="kk-login-form" asp-action="ForgotPassword" method="post">
            <div class="mb-3">
                <label asp-for="Epost" class="form-label"></label>
                <input asp-for="Epost" class="form-control" placeholder="navn@eksempel.no" autocomplete="email" />
                <span asp-validation-for="Epost" class="text-danger"></span>
            </div>

            <button type="submit" class="kk-login-submit">
                Send lenke
            </button>
        </form>

        <div class="kk-login-footer">
            <p><a asp-action="Login">Tilbake til innlogging</a></p>
        </div>

    </div>
</section>

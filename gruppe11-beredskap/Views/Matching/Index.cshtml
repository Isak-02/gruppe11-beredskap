@using System.Globalization
@model gruppe11_beredskap.Models.MatchingViewModel
@{
    ViewData["Title"] = "Kobling";
}

<h1>Kobling av behov og ressurser</h1>

<!-- Fylkesfilter: viser bare behov og ressurser som ligger i valgt fylke, både i kartet og i tabellene -->
<div class="row g-2 align-items-end mb-3">
    <div class="col-sm-6 col-md-4">
        <label for="fylkeFilter" class="form-label">Fylke</label>
        <select id="fylkeFilter" class="form-select">
            <option value="">Alle fylker</option>
        </select>
    </div>
</div>

<div class="kart-ramme mb-4">
    <div id="map"></div>
    <button type="button"
            id="fullskjermKnapp"
            class="kart-info-knapp kart-fullskjerm-knapp"
            aria-label="Vis kartet i fullskjerm"
            title="Vis kartet i fullskjerm">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" />
        </svg>
    </button>
    <div class="kart-info">
        <button type="button"
                class="kart-info-knapp"
                aria-expanded="false"
                aria-controls="kart-tegnforklaring"
                aria-label="Vis tegnforklaring">
            i
        </button>
        <div id="kart-tegnforklaring" class="kart-info-panel" role="region" aria-label="Tegnforklaring">
            <span><span class="behov-ikon behov-hoy" aria-hidden="true"></span> Behov – høy prioritet</span>
            <span><span class="behov-ikon behov-middels" aria-hidden="true"></span> Behov – middels prioritet</span>
            <span><span class="behov-ikon behov-lav" aria-hidden="true"></span> Behov – lav prioritet</span>
            <span><img src="https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png" alt="" /> Ressurs</span>
        </div>
    </div>
</div>

<form asp-action="Koble" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row g-4">
        <div class="col-lg-6">
            <!-- Behov som ikke er løst. Tildelte behov står også her, så de kan få flere ressurser. -->
            <h2 class="h5">Åpne behov</h2>
            @if (!Model.ÅpneBehov.Any())
            {
                <p>Ingen åpne behov.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-top">
                        <thead>
                        <tr>
                            <th></th>
                            <th>Behov</th>
                            <th>Prioritet</th>
                            <th>Status</th>
                            <th>Område</th>
                            <th>Frist</th>
                            <th>Kontakt</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var b in Model.ÅpneBehov)
                        {
                            <!-- Posisjonen brukes av fylkesfilteret -->
                            <tr data-fylke-rad
                                data-lat="@(b.Latitude?.ToString(CultureInfo.InvariantCulture))"
                                data-lng="@(b.Longitude?.ToString(CultureInfo.InvariantCulture))">
                                <td><input type="radio" name="BehovId" value="@b.Id" class="form-check-input" /></td>
                                <td>
                                    #@b.Id @b.TypeBehov
                                    @if (!string.IsNullOrWhiteSpace(b.Beskrivelse))
                                    {
                                        <div class="small text-muted">Beskrivelse:</div>
                                        <div class="small text-muted">@b.Beskrivelse</div>
                                    }
                                </td>
                                <td>@b.Prioritet</td>
                                <td>@b.Status</td>
                                <td>@b.GeografiskOmrade</td>
                                <td>@b.Tidspunkt.ToString("g")</td>
                                <td>@b.Kontaktpunkt</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            <span asp-validation-for="BehovId" class="text-danger"></span>
        </div>

        <div class="col-lg-6">
            <!-- Avkrysningsbokser, så flere ressurser kan kobles til samme behov på én gang -->
            <h2 class="h5">Ledige ressurser</h2>
            @if (!Model.LedigeRessurser.Any())
            {
                <p>Ingen ledige ressurser.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-top">
                        <thead>
                        <tr>
                            <th></th>
                            <th>Ressurs</th>
                            <th>Drivstoff</th>
                            <th>Last</th>
                            <th>Område</th>
                            <th>Kontakt</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var r in Model.LedigeRessurser)
                        {
                            <!-- Posisjonen brukes av fylkesfilteret -->
                            <tr data-fylke-rad
                                data-lat="@(r.Latitude?.ToString(CultureInfo.InvariantCulture))"
                                data-lng="@(r.Longitude?.ToString(CultureInfo.InvariantCulture))">
                                <td><input type="checkbox" name="RessursIder" value="@r.Id" class="form-check-input" /></td>
                                <td>
                                    #@r.Id
                                    @(r.TypeRessurs == "Annet" && !string.IsNullOrWhiteSpace(r.AnnenType)
                                        ? $"Annet: {r.AnnenType}"
                                        : r.TypeRessurs)
                                    @if (!string.IsNullOrWhiteSpace(r.Beskrivelse))
                                    {
                                        <div class="small text-muted">Beskrivelse:</div>
                                        <div class="small text-muted">@r.Beskrivelse</div>
                                    }
                                </td>
                                <td>@(r.Drivstofftype ?? "-")</td>
                                <td>@(r.Lastekapasitet.HasValue ? $"{r.Lastekapasitet} t" : "-")</td>
                                <td>@r.GeografiskOmrade</td>
                                <td>@r.Kontaktpunkt</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            <span asp-validation-for="RessursIder" class="text-danger"></span>
        </div>
    </div>

    <button type="submit" class="btn btn-primary mt-3 mb-4">Koble valgt behov og ressurser</button>
</form>

@{
    // Aktive koblinger samles per behov, så et behov med flere ressurser står i én rad
    var aktive = Model.Matchinger
        .Where(m => m.LostTidspunkt == null)
        .GroupBy(m => m.BehovId)
        .ToList();
    var løste = Model.Matchinger.Where(m => m.LostTidspunkt != null).ToList();
}

<h2 class="h5">Aktive koblinger</h2>

@if (!aktive.Any())
{
    <p>Ingen aktive koblinger.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
            <tr>
                <th>Behov</th>
                <th>Ressurser</th>
                <th>Koblet</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var gruppe in aktive)
            {
                <tr>
                    <td>@gruppe.First().Behov</td>
                    <td>
                        @foreach (var m in gruppe)
                        {
                            <div>@m.Ressurs</div>
                        }
                    </td>
                    <td>@gruppe.Min(m => m.OpprettetTidspunkt).ToString("g")</td>
                    <td>
                        <!-- Løst: behovet blir Løst, og alle ressursene blir Tilgjengelig igjen -->
                        <form asp-action="Løs" method="post">
                            <input type="hidden" name="behovId" value="@gruppe.Key" />
                            <button type="submit" class="btn btn-sm btn-danger">Løst</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<h2 class="h5 mt-4">Løste koblinger</h2>

@if (!løste.Any())
{
    <p>Ingen løste koblinger ennå.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
            <tr>
                <th>Behov</th>
                <th>Ressurs</th>
                <th>Koblet</th>
                <th>Løst</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var m in løste)
            {
                <tr>
                    <td>@m.Behov</td>
                    <td>@m.Ressurs</td>
                    <td>@m.OpprettetTidspunkt.ToString("g")</td>
                    <td>@m.LostTidspunkt!.Value.ToString("g")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        var map = L.map('map').setView([58.1467, 7.9956], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }).addTo(map);

        // Åpne behov og ledige ressurser fra controlleren (de samme som i tabellene under kartet)
        var åpneBehov = @Json.Serialize(Model.ÅpneBehov);
        var ledigeRessurser = @Json.Serialize(Model.LedigeRessurser);

        // Lager utropstegn-ikonet for et behov, med farge etter prioritet:
        // høy = rød, middels = oransje, lav = gul. Utseendet, også selve "!", ligger i site.css.
        // Ikonet er rundt, så midten peker på posisjonen, og popupen åpnes rett over.
        function lagBehovIkon(prioritet) {
            var fargeKlasse = 'behov-hoy';

            if (prioritet === "Middels") {
                fargeKlasse = 'behov-middels';
            } else if (prioritet === "Lav") {
                fargeKlasse = 'behov-lav';
            }

            return L.divIcon({
                className: 'behov-ikon ' + fargeKlasse,
                html: '',
                iconSize: [26, 26],
                iconAnchor: [13, 13],
                popupAnchor: [0, -13]
            });
        }

        // Gruppe med alle markørene, slik at kartet kan zoome så alle vises
        var alleMarkorer = L.featureGroup().addTo(map);

        // Sjekker at posisjonen finnes og er innenfor gyldige verdier
        function harGyldigPosisjon(lat, lng) {
            return typeof lat === 'number' && typeof lng === 'number' &&
                lat >= -90 && lat <= 90 && lng >= -180 && lng <= 180;
        }

        // Lager innholdet i popupen. textContent gjør at tekst fra skjemaene vises som tekst, ikke som HTML.
        function lagPopup(overskrift, linjer) {
            var innhold = document.createElement('div');

            var tittel = document.createElement('strong');
            tittel.textContent = overskrift;
            innhold.appendChild(tittel);

            linjer.forEach(function (tekst) {
                var linje = document.createElement('div');
                linje.textContent = tekst;
                innhold.appendChild(linje);
            });

            return innhold;
        }

        // Behov: utropstegn-ikon. Behov uten gyldig posisjon hoppes over.
        åpneBehov.forEach(function (behov) {
            if (!harGyldigPosisjon(behov.latitude, behov.longitude)) {
                return;
            }

            L.marker([behov.latitude, behov.longitude], { icon: lagBehovIkon(behov.prioritet) })
                .bindPopup(lagPopup("Behov #" + behov.id + ": " + behov.typeBehov, [
                    behov.beskrivelse,
                    "Prioritet: " + behov.prioritet,
                    "Kontakt: " + behov.kontaktpunkt
                ]))
                .addTo(alleMarkorer);
        });

        // Ressurser: samme markør som på Registrer ressurs-siden (standardmarkøren i Leaflet)
        ledigeRessurser.forEach(function (ressurs) {
            if (!harGyldigPosisjon(ressurs.latitude, ressurs.longitude)) {
                return;
            }

            var type = ressurs.typeRessurs;
            if (type === "Annet" && ressurs.annenType) {
                type = "Annet: " + ressurs.annenType;
            }

            L.marker([ressurs.latitude, ressurs.longitude])
                .bindPopup(lagPopup("Ressurs #" + ressurs.id + ": " + type, [
                    ressurs.beskrivelse,
                    "Kontakt: " + ressurs.kontaktpunkt
                ]))
                .addTo(alleMarkorer);
        });

        // Zoomer så alle markørene vises. Er det ingen, beholdes standardvisningen.
        // maxZoom hindrer at kartet zoomer helt inn når det bare er én markør.
        if (alleMarkorer.getLayers().length > 0) {
            map.fitBounds(alleMarkorer.getBounds(), { padding: [30, 30], maxZoom: 13 });
        }

        var kartInfo = document.querySelector(".kart-info");
        var kartInfoKnapp = kartInfo && kartInfo.querySelector(".kart-info-knapp");
        if (kartInfo && kartInfoKnapp) {
            kartInfoKnapp.addEventListener("click", function (event) {
                event.stopPropagation();
                var apen = kartInfo.classList.toggle("is-open");
                kartInfoKnapp.setAttribute("aria-expanded", apen ? "true" : "false");
            });

            document.addEventListener("click", function (event) {
                if (kartInfo.contains(event.target)) return;
                kartInfo.classList.remove("is-open");
                kartInfoKnapp.setAttribute("aria-expanded", "false");
            }, true);
        }

        // Fullskjerm for kartet. Hele rammen vises i fullskjerm, så infoknappen og tegnforklaringen er med.
        // Esc eller nytt klikk på knappen avslutter.
        var kartRamme = document.querySelector(".kart-ramme");
        var fullskjermKnapp = document.getElementById("fullskjermKnapp");

        fullskjermKnapp.addEventListener("click", function () {
            if (document.fullscreenElement) {
                document.exitFullscreen();
            } else {
                kartRamme.requestFullscreen();
            }
        });

        // Når fullskjerm slås av eller på: oppdater teksten på knappen, og la kartet tilpasse seg ny størrelse
        document.addEventListener("fullscreenchange", function () {
            var erFullskjerm = document.fullscreenElement === kartRamme;
            var tekst = erFullskjerm ? "Avslutt fullskjerm" : "Vis kartet i fullskjerm";

            fullskjermKnapp.setAttribute("aria-label", tekst);
            fullskjermKnapp.setAttribute("title", tekst);
            map.invalidateSize();
        });

        // ---------- Fylkesfilter ----------
        // Samme fylkesgrenser og samme sjekk som på Ressurser per fylke (Views/Ressurs/PerFylke.cshtml)

        var fylkeFilter = document.getElementById('fylkeFilter');
        var fylker = [];          // Fylkene fra fylker.json, i samme rekkefølge som i lista
        var valgtFylkeLag = null; // Grensen til valgt fylke i kartet

        // Sjekker om et punkt ligger inne i en ring (en liste med hjørner). Vanlig "ray casting":
        // vi trekker en tenkt linje mot høyre fra punktet og teller hvor mange kanter den krysser.
        // Oddetall betyr at punktet er inne.
        function punktIRing(lng, lat, ring) {
            var inne = false;
            for (var i = 0, j = ring.length - 1; i < ring.length; j = i++) {
                var xi = ring[i][0], yi = ring[i][1];
                var xj = ring[j][0], yj = ring[j][1];
                var krysser = (yi > lat) !== (yj > lat) &&
                    lng < (xj - xi) * (lat - yi) / (yj - yi) + xi;
                if (krysser) {
                    inne = !inne;
                }
            }
            return inne;
        }

        // Et polygon er en ytre ring, og eventuelle hull (f.eks. Oslo inne i Akershus)
        function punktIPolygon(lng, lat, polygon) {
            if (!punktIRing(lng, lat, polygon[0])) {
                return false;
            }
            for (var i = 1; i < polygon.length; i++) {
                if (punktIRing(lng, lat, polygon[i])) {
                    return false;
                }
            }
            return true;
        }

        // Et fylke kan bestå av flere deler (øyer), da er geometrien et MultiPolygon
        function punktIFylke(lng, lat, fylke) {
            var geometri = fylke.geometry;
            if (geometri.type === 'Polygon') {
                return punktIPolygon(lng, lat, geometri.coordinates);
            }
            for (var i = 0; i < geometri.coordinates.length; i++) {
                if (punktIPolygon(lng, lat, geometri.coordinates[i])) {
                    return true;
                }
            }
            return false;
        }

        // Viser bare det som ligger i valgt fylke. Tom verdi betyr alle fylker.
        function filtrerPaFylke(indeks) {
            var fylke = indeks === '' ? null : fylker[indeks];

            // Tabellradene. En rad som skjules, får også fjernet haken, så den ikke sendes med skjemaet.
            document.querySelectorAll('[data-fylke-rad]').forEach(function (rad) {
                var lat = parseFloat(rad.getAttribute('data-lat'));
                var lng = parseFloat(rad.getAttribute('data-lng'));
                var vis = !fylke || (!isNaN(lat) && !isNaN(lng) && punktIFylke(lng, lat, fylke));

                rad.hidden = !vis;
                if (!vis) {
                    var valg = rad.querySelector('input');
                    if (valg) valg.checked = false;
                }
            });

            // Markørene i kartet
            alleMarkorer.eachLayer(function (markor) {
                var posisjon = markor.getLatLng();
                var vis = !fylke || punktIFylke(posisjon.lng, posisjon.lat, fylke);
                if (vis) {
                    markor.addTo(map);
                } else {
                    map.removeLayer(markor);
                }
            });

            // Grensen til valgt fylke, og zoom inn på det. Uten fylke zoomes det ut til alle markørene igjen.
            if (valgtFylkeLag) {
                map.removeLayer(valgtFylkeLag);
                valgtFylkeLag = null;
            }
            if (fylke) {
                valgtFylkeLag = L.geoJSON(fylke, {
                    style: { color: '#1b5e20', weight: 3, fillColor: '#2e7d32', fillOpacity: 0.08 },
                    interactive: false,
                    attribution: 'Fylkesgrenser &copy; Kartverket'
                }).addTo(map);
                map.fitBounds(valgtFylkeLag.getBounds());
            } else if (alleMarkorer.getLayers().length > 0) {
                map.fitBounds(alleMarkorer.getBounds(), { padding: [30, 30], maxZoom: 13 });
            }
        }

        // Henter fylkesgrensene (GeoJSON fra Kartverket) og fyller lista
        fetch('@Url.Content("~/data/fylker.json")')
            .then(function (svar) { return svar.json(); })
            .then(function (data) {
                fylker = data.features;
                fylker.forEach(function (fylke, indeks) {
                    var valg = document.createElement('option');
                    valg.value = indeks;
                    valg.textContent = fylke.properties.navn;
                    fylkeFilter.appendChild(valg);
                });
            });

        fylkeFilter.addEventListener('change', function () {
            filtrerPaFylke(fylkeFilter.value);
        });
    </script>
}
@using gruppe11_beredskap.Services
@model gruppe11_beredskap.Models.MatchingViewModel
@{
    ViewData["Title"] = "Kobling";
}

<div class="kobling-side">
<h1 class="d-print-none">Kobling av behov og ressurser</h1>
<p class="d-print-none">Velg ett eller flere fylker i listen eller i kartet. Listene viser behov og ressurser der. Bare behov og bare ressurser filtrerer kartet. Skriv ut henter bare ressursene. Finn match viser ressurser som kan passe, for eksempel lastebil til et transportbehov.</p>

<h1 id="utskriftOverskrift" class="kobling-bare-utskrift" hidden></h1>
<p id="utskriftTom" class="kobling-bare-utskrift" hidden></p>

<div class="kobling-filter mb-3 d-print-none">
    <div class="fylke-velger" id="fylkeVelger">
        <label class="form-label" id="fylkeLabel" for="fylkeKnapp">Fylker</label>
        <button type="button" id="fylkeKnapp" class="fylke-knapp" aria-expanded="false" aria-controls="fylkePanel">
            Velg fylker …
        </button>
        <div id="fylkePanel" class="fylke-panel" hidden role="group" aria-labelledby="fylkeLabel">
            <div id="fylkeListe"></div>
        </div>
    </div>
    <div>
        <div class="form-label">Vis i kartet</div>
        <div class="btn-group" role="group" aria-label="Visning i kartet">
            <button type="button" class="btn btn-outline-primary active" data-visning="alle" aria-pressed="true">Begge</button>
            <button type="button" class="btn btn-outline-primary" data-visning="behov" aria-pressed="false">Bare behov</button>
            <button type="button" class="btn btn-outline-primary" data-visning="ressurser" aria-pressed="false">Bare ressurser</button>
        </div>
    </div>
    <button type="button" id="skrivUtKnapp" class="btn btn-primary" disabled>Skriv ut ressurser</button>
</div>

<div class="kart-ramme mb-4 d-print-none">
    <div id="map"></div>
    <button type="button"
            id="fullskjermKnapp"
            class="kart-info-knapp kart-fullskjerm-knapp"
            aria-label="Vis kartet i fullskjerm"
            title="Vis kartet i fullskjerm">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" />
        </svg>
    </button>
    <div class="kart-info">
        <button type="button"
                class="kart-info-knapp"
                aria-expanded="false"
                aria-controls="kart-tegnforklaring"
                aria-label="Vis tegnforklaring">
            i
        </button>
        <div id="kart-tegnforklaring" class="kart-info-panel" role="region" aria-label="Tegnforklaring">
            <span><span class="behov-ikon behov-hoy" aria-hidden="true"></span> Behov – høy prioritet</span>
            <span><span class="behov-ikon behov-middels" aria-hidden="true"></span> Behov – middels prioritet</span>
            <span><span class="behov-ikon behov-lav" aria-hidden="true"></span> Behov – lav prioritet</span>
            <span>
                <img src="/images/ressurs-ikon.png" alt="Ressurs" />
                Ressurs
            </span>
            <span><span class="kart-klynge-forklaring" aria-hidden="true">3</span> Flere på samme sted</span>
        </div>
    </div>
</div>

<div id="treffBanner" class="alert alert-secondary d-flex flex-wrap align-items-center gap-2 d-print-none" hidden>
    <span>Viser ressurser som kan treffe <strong id="treffTekst"></strong>.</span>
    <button type="button" id="nullstillTreff" class="btn btn-sm btn-outline-primary">Vis alle ressurser</button>
</div>

<form asp-action="Koble" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger d-print-none"></div>

    <p id="ingenFylke" class="d-print-none">Velg ett eller flere fylker for å se behov og ressurser.</p>

    <div class="kobling-lister" id="koblingLister">
        <div class="d-print-none" id="behovKolonne">
            <h2 class="h5" id="behovOverskrift">Åpne behov</h2>
            <p id="ingenBehov" hidden>Ingen åpne behov i valgte fylker.</p>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle kobling-tabell" id="behovTabell" hidden>
                    <tbody>
                    @foreach (var b in Model.ÅpneBehov)
                    {
                        <tr data-id="@b.Id" hidden>
                            <td class="kobling-valg"><input type="radio" name="BehovId" value="@b.Id" class="form-check-input" aria-label="Velg behov #@b.Id" /></td>
                            <td>
                                <div class="kobling-kort-hode">
                                    <strong>#@b.Id @b.TypeBehov</strong>
                                    <button type="button" class="btn btn-sm btn-outline-primary finn-match" data-behov-id="@b.Id">Finn match</button>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(b.Beskrivelse))
                                {
                                    <p class="kobling-kort-tekst">@b.Beskrivelse</p>
                                }
                                <p class="kobling-kort-meta">
                                    <span>@b.Prioritet</span>
                                    <span>@b.Status</span>
                                    @if (!string.IsNullOrWhiteSpace(b.GeografiskOmrade))
                                    {
                                        <span>@b.GeografiskOmrade</span>
                                    }
                                    <span title="@RelativTid.Absolutt(b.OpprettetTidspunkt)">@RelativTid.Tekst(b.OpprettetTidspunkt)</span>
                                    <span>@b.Kontaktpunkt</span>
                                </p>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <span asp-validation-for="BehovId" class="text-danger"></span>
        </div>

        <div id="ressursKolonne">
            <h2 class="h5 d-print-none" id="ressursOverskrift">Ledige ressurser</h2>
            <p id="ingenRessurser" class="d-print-none" hidden>Ingen ledige ressurser i valgte fylker.</p>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle kobling-tabell" id="koblingRessursTabell" hidden>
                    <tbody>
                    @foreach (var r in Model.LedigeRessurser)
                    {
                        <tr data-id="@r.Id" hidden>
                            <td class="kobling-valg skjul-ved-utskrift"><input type="checkbox" name="RessursIder" value="@r.Id" class="form-check-input" aria-label="Velg ressurs #@r.Id" /></td>
                            <td>
                                <strong>
                                    #@r.Id
                                    @(r.TypeRessurs == "Annet" && !string.IsNullOrWhiteSpace(r.AnnenType)
                                        ? $"Annet: {r.AnnenType}"
                                        : r.TypeRessurs)
                                </strong>
                                @if (!string.IsNullOrWhiteSpace(r.Beskrivelse))
                                {
                                    <p class="kobling-kort-tekst">@r.Beskrivelse</p>
                                }
                                <p class="kobling-kort-meta">
                                    @if (!string.IsNullOrWhiteSpace(r.Drivstofftype))
                                    {
                                        <span>@r.Drivstofftype</span>
                                    }
                                    @if (r.Lastekapasitet.HasValue)
                                    {
                                        <span>@r.Lastekapasitet t</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(r.GeografiskOmrade))
                                    {
                                        <span>@r.GeografiskOmrade</span>
                                    }
                                    <span title="@RelativTid.Absolutt(r.OpprettetTidspunkt)">@RelativTid.Tekst(r.OpprettetTidspunkt)</span>
                                    <span>@r.Kontaktpunkt</span>
                                </p>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <span asp-validation-for="RessursIder" class="text-danger d-print-none"></span>
        </div>
    </div>

    <button type="submit" id="kobleKnapp" class="btn btn-primary mt-3 mb-4 d-print-none" hidden>Koble valgt behov og ressurser</button>
</form>

@{
    var aktive = Model.Matchinger
        .Where(m => m.LostTidspunkt == null)
        .GroupBy(m => m.BehovId)
        .ToList();
    var løste = Model.Matchinger.Where(m => m.LostTidspunkt != null).ToList();
}

<div class="d-print-none">
<h2 class="h5">Aktive koblinger</h2>

@if (!aktive.Any())
{
    <p>Ingen aktive koblinger.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
            <tr>
                <th>Behov</th>
                <th>Ressurser</th>
                <th>Koblet</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var gruppe in aktive)
            {
                <tr>
                    <td>@gruppe.First().Behov</td>
                    <td>
                        @foreach (var m in gruppe)
                        {
                            <div>@m.Ressurs</div>
                        }
                    </td>
                    <td>@gruppe.Min(m => m.OpprettetTidspunkt).ToString("g")</td>
                    <td>
                        <form asp-action="Løs" method="post">
                            <input type="hidden" name="behovId" value="@gruppe.Key" />
                            <button type="submit" class="btn btn-sm btn-danger">Løst</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<h2 class="h5 mt-4">Løste koblinger</h2>

@if (!løste.Any())
{
    <p>Ingen løste koblinger ennå.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
            <tr>
                <th>Behov</th>
                <th>Ressurs</th>
                <th>Koblet</th>
                <th>Løst</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var m in løste)
            {
                <tr>
                    <td>@m.Behov</td>
                    <td>@m.Ressurs</td>
                    <td>@m.OpprettetTidspunkt.ToString("g")</td>
                    <td>@m.LostTidspunkt!.Value.ToString("g")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
</div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
    <script>
        var map = L.map('map').setView([65, 13], 4);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }).addTo(map);

        var åpneBehov = @Json.Serialize(Model.ÅpneBehov);
        var ledigeRessurser = @Json.Serialize(Model.LedigeRessurser);
        // Samme typekart som BehovRessursTreff. Treff-regelen under holdes lik den klassen.
        var treffKart = @Json.Serialize(BehovRessursTreff.Kart);

        var visning = 'alle';
        var treffBehovId = null;
        var fylker = [];
        var fylkeLag = null;
        var markorer = L.markerClusterGroup({
            showCoverageOnHover: false,
            spiderfyOnMaxZoom: true,
            zoomToBoundsOnClick: true,
            maxClusterRadius: 60,
            iconCreateFunction: function (klynge) {
                var antall = klynge.getChildCount();
                var px = antall >= 100 ? 52 : antall >= 10 ? 44 : 36;
                return L.divIcon({
                    html: '<span title="' + antall + ' på samme sted">' + antall + '</span>',
                    className: 'kart-klynge',
                    iconSize: [px, px]
                });
            }
        }).addTo(map);

        var vanligStil = { color: '#5E615C', weight: 1, fillColor: '#1E4A38', fillOpacity: 0.05 };
        var valgtStil = { color: '#12241C', weight: 3, fillColor: '#1E4A38', fillOpacity: 0.2 };

        var fylkeVelger = document.getElementById('fylkeVelger');
        var fylkeKnapp = document.getElementById('fylkeKnapp');
        var fylkePanel = document.getElementById('fylkePanel');
        var fylkeListe = document.getElementById('fylkeListe');
        var skrivUtKnapp = document.getElementById('skrivUtKnapp');
        var ingenFylke = document.getElementById('ingenFylke');
        var behovKolonne = document.getElementById('behovKolonne');
        var ressursKolonne = document.getElementById('ressursKolonne');
        var behovTabell = document.getElementById('behovTabell');
        var ressursTabell = document.getElementById('koblingRessursTabell');
        var ingenBehov = document.getElementById('ingenBehov');
        var ingenRessurser = document.getElementById('ingenRessurser');
        var behovOverskrift = document.getElementById('behovOverskrift');
        var ressursOverskrift = document.getElementById('ressursOverskrift');
        var treffBanner = document.getElementById('treffBanner');
        var treffTekst = document.getElementById('treffTekst');
        var kobleKnapp = document.getElementById('kobleKnapp');
        var utskriftOverskrift = document.getElementById('utskriftOverskrift');
        var utskriftTom = document.getElementById('utskriftTom');

        function harGyldigPosisjon(lat, lng) {
            return typeof lat === 'number' && typeof lng === 'number' &&
                lat >= -90 && lat <= 90 && lng >= -180 && lng <= 180;
        }

        function lagBehovIkon(prioritet) {
            var fargeKlasse = 'behov-hoy';
            if (prioritet === 'Middels') {
                fargeKlasse = 'behov-middels';
            } else if (prioritet === 'Lav') {
                fargeKlasse = 'behov-lav';
            }

            return L.divIcon({
                className: 'behov-ikon ' + fargeKlasse,
                html: '',
                iconSize: [26, 26],
                iconAnchor: [13, 13],
                popupAnchor: [0, -13]
            });
        }

        var ressursIkon = L.icon({
            iconUrl: '@Url.Content("~/images/ressurs-ikon.png")',
            iconSize: [25, 40],
            iconAnchor: [12, 40],
            popupAnchor: [0, -36]
        });
        
        function lagPopup(overskrift, linjer, knapp) {
            var innhold = document.createElement('div');
            var tittel = document.createElement('strong');
            tittel.textContent = overskrift;
            innhold.appendChild(tittel);

            linjer.forEach(function (tekst) {
                if (!tekst) return;
                var linje = document.createElement('div');
                linje.textContent = tekst;
                innhold.appendChild(linje);
            });

            if (knapp) {
                innhold.appendChild(knapp);
            }

            return innhold;
        }

        function punktIRing(lng, lat, ring) {
            var inne = false;
            for (var i = 0, j = ring.length - 1; i < ring.length; j = i++) {
                var xi = ring[i][0], yi = ring[i][1];
                var xj = ring[j][0], yj = ring[j][1];
                var krysser = (yi > lat) !== (yj > lat) &&
                    lng < (xj - xi) * (lat - yi) / (yj - yi) + xi;
                if (krysser) {
                    inne = !inne;
                }
            }
            return inne;
        }

        function punktIPolygon(lng, lat, polygon) {
            if (!punktIRing(lng, lat, polygon[0])) {
                return false;
            }
            for (var i = 1; i < polygon.length; i++) {
                if (punktIRing(lng, lat, polygon[i])) {
                    return false;
                }
            }
            return true;
        }

        function punktIFylke(lng, lat, fylke) {
            var geometri = fylke.geometry;
            if (geometri.type === 'Polygon') {
                return punktIPolygon(lng, lat, geometri.coordinates);
            }
            for (var i = 0; i < geometri.coordinates.length; i++) {
                if (punktIPolygon(lng, lat, geometri.coordinates[i])) {
                    return true;
                }
            }
            return false;
        }

        function valgteIndekser() {
            return Array.from(fylkeListe.querySelectorAll('input:checked')).map(function (boks) {
                return Number(boks.value);
            });
        }

        function iValgteFylker(lat, lng) {
            var valgt = valgteIndekser();
            if (valgt.length === 0 || !harGyldigPosisjon(lat, lng)) {
                return false;
            }
            for (var i = 0; i < valgt.length; i++) {
                if (punktIFylke(lng, lat, fylker[valgt[i]])) {
                    return true;
                }
            }
            return false;
        }

        function finnBehov(id) {
            id = Number(id);
            return åpneBehov.find(function (behov) { return behov.id === id; }) || null;
        }

        function finnRessurs(id) {
            id = Number(id);
            return ledigeRessurser.find(function (ressurs) { return ressurs.id === id; }) || null;
        }

        function liten(tekst) {
            return (tekst || '').toLocaleLowerCase('nb').trim();
        }

        // Lik BehovRessursTreff.Treffer: teksten inneholder ordet, eller et ord på minst 4 tegn
        // er selv en del av et kjent ressursnavn.
        function treffer(tekst, mulig) {
            var a = liten(tekst);
            var b = liten(mulig);
            if (!a || !b) return false;
            if (a.indexOf(b) >= 0) return true;
            return a.length >= 4 && b.indexOf(a) >= 0;
        }

        function ressursNavn(ressurs) {
            if (ressurs.typeRessurs === 'Annet' && ressurs.annenType && ressurs.annenType.trim()) {
                return ressurs.annenType;
            }
            return ressurs.typeRessurs || '';
        }

        function matcherBehov(behov, ressurs) {
            if (!behov || !behov.typeBehov) return false;
            var navn = ressursNavn(ressurs);
            var beskrivelse = ressurs.beskrivelse || '';
            var nokkel = Object.keys(treffKart).find(function (k) {
                return liten(k) === liten(behov.typeBehov);
            });
            var mulige = nokkel ? treffKart[nokkel] : null;
            if (mulige) {
                for (var i = 0; i < mulige.length; i++) {
                    if (treffer(navn, mulige[i]) || treffer(beskrivelse, mulige[i])) {
                        return true;
                    }
                }
            }
            return treffer(navn, behov.typeBehov) || treffer(beskrivelse, behov.typeBehov);
        }

        function fylkeTekst(navn) {
            if (navn.length === 0) return '';
            if (navn.length === 1) return navn[0];
            if (navn.length === 2) return navn[0] + ' og ' + navn[1];
            return navn.slice(0, -1).join(', ') + ' og ' + navn[navn.length - 1];
        }

        function settFylkePanel(apen) {
            fylkePanel.hidden = !apen;
            fylkeVelger.classList.toggle('er-apen', apen);
            fylkeKnapp.setAttribute('aria-expanded', apen ? 'true' : 'false');
        }

        function finnMatch(id) {
            var radio = document.querySelector('input[name="BehovId"][value="' + id + '"]');
            if (radio) radio.checked = true;
            treffBehovId = Number(id);
            oppdater(false);
        }

        function settVisning(ny) {
            visning = ny;
            document.querySelectorAll('[data-visning]').forEach(function (knapp) {
                var valgt = knapp.getAttribute('data-visning') === ny;
                knapp.classList.toggle('active', valgt);
                knapp.setAttribute('aria-pressed', valgt ? 'true' : 'false');
            });
            oppdater(false);
        }

        function oppdater(zoomTilFylker) {
            var valgt = valgteIndekser();
            var harFylke = valgt.length > 0;
            var navn = valgt.map(function (indeks) { return fylker[indeks].properties.navn; });
            var tekst = fylkeTekst(navn);

            fylkeKnapp.textContent = tekst || 'Velg fylker …';
            skrivUtKnapp.disabled = !harFylke;
            ingenFylke.hidden = harFylke;
            kobleKnapp.hidden = !harFylke;

            if (treffBehovId != null) {
                var valgtBehov = finnBehov(treffBehovId);
                if (!valgtBehov || !iValgteFylker(valgtBehov.latitude, valgtBehov.longitude)) {
                    treffBehovId = null;
                }
            }

            var treffBehov = treffBehovId == null ? null : finnBehov(treffBehovId);
            treffBanner.hidden = treffBehov == null;
            if (treffBehov) {
                treffTekst.textContent = '#' + treffBehov.id + ' ' + treffBehov.typeBehov;
            }

            var visBehov = visning !== 'ressurser';
            var visRessurser = visning !== 'behov';
            behovKolonne.classList.toggle('er-skjult-pa-skjerm', !harFylke);
            ressursKolonne.classList.toggle('er-skjult-pa-skjerm', !harFylke);

            markorer.clearLayers();
            var behovAntall = 0;
            var ressursAntall = 0;
            var utskriftAntall = 0;

            behovTabell.querySelectorAll('tbody tr').forEach(function (rad) {
                var behov = finnBehov(rad.getAttribute('data-id'));
                var iFylket = behov && iValgteFylker(behov.latitude, behov.longitude);
                var synlig = harFylke && iFylket;
                rad.hidden = !synlig;
                rad.classList.toggle('er-valgt-treff', synlig && treffBehov && behov.id === treffBehov.id);
                var radio = rad.querySelector('input[type="radio"]');
                if (radio && !iFylket) radio.checked = false;
                if (synlig) {
                    behovAntall++;
                }
                if (synlig && visBehov) {
                    var knapp = document.createElement('button');
                    knapp.type = 'button';
                    knapp.className = 'btn btn-sm btn-primary mt-2';
                    knapp.textContent = 'Finn match';
                    knapp.addEventListener('click', function () { finnMatch(behov.id); });
                    L.marker([behov.latitude, behov.longitude], { icon: lagBehovIkon(behov.prioritet) })
                        .bindPopup(lagPopup('Behov #' + behov.id + ': ' + behov.typeBehov, [
                            behov.beskrivelse,
                            'Prioritet: ' + behov.prioritet,
                            'Kontakt: ' + behov.kontaktpunkt
                        ], knapp))
                        .addTo(markorer);
                }
            });

            ressursTabell.querySelectorAll('tbody tr').forEach(function (rad) {
                var ressurs = finnRessurs(rad.getAttribute('data-id'));
                var iFylket = ressurs && iValgteFylker(ressurs.latitude, ressurs.longitude);
                var erTreff = !treffBehov || (ressurs && matcherBehov(treffBehov, ressurs));
                var kanSkrivesUt = harFylke && iFylket && erTreff;
                rad.hidden = !kanSkrivesUt;
                rad.classList.toggle('kan-skrives-ut', kanSkrivesUt);
                var boks = rad.querySelector('input[type="checkbox"]');
                if (boks && !kanSkrivesUt) boks.checked = false;
                if (!kanSkrivesUt) return;
                utskriftAntall++;
                ressursAntall++;
                if (!visRessurser || !harGyldigPosisjon(ressurs.latitude, ressurs.longitude)) return;
                var type = ressursNavn(ressurs);
                if (ressurs.typeRessurs === 'Annet') type = 'Annet: ' + type;
                L.marker([ressurs.latitude, ressurs.longitude], { icon: ressursIkon })
                    .bindPopup(lagPopup('Ressurs #' + ressurs.id + ': ' + type, [
                        ressurs.beskrivelse,
                        'Kontakt: ' + ressurs.kontaktpunkt
                    ]))
                    .addTo(markorer);
            });

            if (markorer.getLayers().length > 0) {
                markorer.bringToFront();
            }

            behovOverskrift.textContent = harFylke ? 'Åpne behov (' + behovAntall + ')' : 'Åpne behov';
            ressursOverskrift.textContent = treffBehov
                ? 'Ressurser som kan treffe (' + ressursAntall + ')'
                : (harFylke ? 'Ledige ressurser (' + ressursAntall + ')' : 'Ledige ressurser');

            ingenBehov.hidden = !harFylke || behovAntall > 0;
            ingenBehov.textContent = 'Ingen åpne behov i valgte fylker.';
            behovTabell.hidden = !harFylke || behovAntall === 0;

            var tomRessurs = treffBehov
                ? 'Ingen ressurser i valgte fylker treffer dette behovet.'
                : 'Ingen ledige ressurser i valgte fylker.';
            ingenRessurser.hidden = !harFylke || ressursAntall > 0;
            ingenRessurser.textContent = tomRessurs;
            ressursTabell.hidden = !harFylke || ressursAntall === 0;
            ressursTabell.classList.toggle('er-tom-utskrift', utskriftAntall === 0);

            if (!harFylke) {
                utskriftOverskrift.textContent = 'Ingen fylker er valgt.';
                utskriftTom.hidden = false;
                utskriftTom.textContent = 'Velg ett eller flere fylker for å skrive ut ressurser.';
            } else if (utskriftAntall === 0) {
                utskriftOverskrift.textContent = 'Tilgjengelige ressurser i ' + tekst;
                utskriftTom.hidden = false;
                utskriftTom.textContent = tomRessurs;
            } else {
                var heading = 'Tilgjengelige ressurser i ' + tekst + ' (' + utskriftAntall + ')';
                if (treffBehov) heading += ', som kan treffe behov #' + treffBehov.id + ' ' + treffBehov.typeBehov;
                utskriftOverskrift.textContent = heading;
                utskriftTom.hidden = true;
            }
            utskriftOverskrift.hidden = false;

            if (fylkeLag) {
                var grenser = L.featureGroup();
                fylkeLag.eachLayer(function (lag) {
                    var indeks = fylker.indexOf(lag.feature);
                    var erValgt = valgt.indexOf(indeks) >= 0;
                    lag.setStyle(erValgt ? valgtStil : vanligStil);
                    if (erValgt) grenser.addLayer(lag);
                });
                if (zoomTilFylker && grenser.getLayers().length > 0) {
                    map.fitBounds(grenser.getBounds(), { padding: [24, 24], maxZoom: 9 });
                }
                if (zoomTilFylker && grenser.getLayers().length === 0) {
                    map.setView([65, 13], 4);
                }
            }
        }

        document.querySelectorAll('.finn-match').forEach(function (knapp) {
            knapp.addEventListener('click', function () {
                finnMatch(knapp.getAttribute('data-behov-id'));
            });
        });

        document.getElementById('nullstillTreff').addEventListener('click', function () {
            treffBehovId = null;
            oppdater(false);
        });

        document.querySelectorAll('[data-visning]').forEach(function (knapp) {
            knapp.addEventListener('click', function () {
                settVisning(knapp.getAttribute('data-visning'));
            });
        });

        fylkeKnapp.addEventListener('click', function () {
            settFylkePanel(fylkePanel.hidden);
        });

        document.addEventListener('click', function (event) {
            if (!fylkeVelger.contains(event.target)) {
                settFylkePanel(false);
            }
        });

        skrivUtKnapp.addEventListener('click', function () {
            window.print();
        });

        fetch('@Url.Content("~/data/fylker.json")')
            .then(function (svar) { return svar.json(); })
            .then(function (data) {
                fylker = data.features;
                fylker.forEach(function (fylke, indeks) {
                    var label = document.createElement('label');
                    var boks = document.createElement('input');
                    boks.type = 'checkbox';
                    boks.value = String(indeks);
                    boks.className = 'form-check-input';
                    boks.addEventListener('change', function () { oppdater(true); });
                    label.appendChild(boks);
                    label.appendChild(document.createTextNode(fylke.properties.navn));
                    fylkeListe.appendChild(label);
                });

                fylkeLag = L.geoJSON(data, {
                    style: vanligStil,
                    attribution: 'Fylkesgrenser © Kartverket',
                    onEachFeature: function (fylke, lag) {
                        lag.bindTooltip(fylke.properties.navn, { sticky: true });
                        lag.on('click', function () {
                            var boks = fylkeListe.querySelector('input[value="' + fylker.indexOf(fylke) + '"]');
                            if (!boks) return;
                            boks.checked = !boks.checked;
                            oppdater(true);
                        });
                    }
                }).addTo(map);

                oppdater(false);
            });

        var kartInfo = document.querySelector('.kart-info');
        var kartInfoKnapp = kartInfo && kartInfo.querySelector('.kart-info-knapp');
        if (kartInfo && kartInfoKnapp) {
            kartInfoKnapp.addEventListener('click', function (event) {
                event.stopPropagation();
                var apen = kartInfo.classList.toggle('is-open');
                kartInfoKnapp.setAttribute('aria-expanded', apen ? 'true' : 'false');
            });

            document.addEventListener('click', function (event) {
                if (kartInfo.contains(event.target)) return;
                kartInfo.classList.remove('is-open');
                kartInfoKnapp.setAttribute('aria-expanded', 'false');
            }, true);
        }

        var kartRamme = document.querySelector('.kart-ramme');
        var fullskjermKnapp = document.getElementById('fullskjermKnapp');

        fullskjermKnapp.addEventListener('click', function () {
            if (document.fullscreenElement) {
                document.exitFullscreen();
            } else {
                kartRamme.requestFullscreen();
            }
        });

        document.addEventListener('fullscreenchange', function () {
            var erFullskjerm = document.fullscreenElement === kartRamme;
            var fullskjermTekst = erFullskjerm ? 'Avslutt fullskjerm' : 'Vis kartet i fullskjerm';
            fullskjermKnapp.setAttribute('aria-label', fullskjermTekst);
            fullskjermKnapp.setAttribute('title', fullskjermTekst);
            map.invalidateSize();
        });
    </script>
}

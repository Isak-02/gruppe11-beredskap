
@{
    ViewData["Title"] = "Hjemmeside";
}

<section class="kk-home">
    <div class="kk-home-content">

        <div class="kk-intro">
            <p class="kk-eyebrow">VELKOMMEN TIL KARTKRISE</p>

            <h1>
                Sammen står vi sterkere<br />
                i krisesituasjoner
            </h1>

            <p class="kk-description">
                KartKrise gjør det enklere å bidra når det virkelig
                gjelder. Registrer ressurser som kan hjelpe andre
                i en krisesituasjon.
            </p>
        </div>

        <div class="row g-4 kk-actions">
            <div class="col-12 col-lg-7">
                <div class="kk-card kk-resource-card">

                    <div class="kk-card-icon kk-green">
                        +
                    </div>

                    <h2>Har du ressurser som kan hjelpe?</h2>

                    <p>
                        Enten du har tilgjengelig utstyr,
                        transport eller annen kapasitet,
                        kan ditt bidrag gjøre en forskjell.
                    </p>

                    <a asp-controller="Ressurs"
                       asp-action="Registrer"
                       class="kk-button kk-button-green">
                        Registrer ressurs &rarr;
                    </a>

                </div>
            </div>
        </div>

    </div>
</section>

<!-- INNLOGGING - DESIGNPROTOTYPE -->

<section id="innlogging" class="kk-login-section">
    <div class="kk-login-card">

        <!-- Logg inn -->
        <div id="kk-login-view">

            <div class="kk-login-heading">
                <h2>Logg inn</h2>
            </div>

            <form class="kk-login-form" onsubmit="return false;">

                <div class="mb-3">
                    <label for="kk-email" class="form-label">
                        E-postadresse
                    </label>
                    <input type="email"
                           class="form-control"
                           id="kk-email"
                           placeholder="navn@eksempel.no"
                           autocomplete="off" />
                </div>

                <div class="mb-3">
                    <label for="kk-password" class="form-label">
                        Passord
                    </label>
                    <input type="password"
                           class="form-control"
                           id="kk-password"
                           placeholder="Skriv inn passord"
                           autocomplete="off" />
                </div>

                <button type="button"
                        class="kk-login-submit"
                        disabled>
                    Logg inn
                </button>
            </form>

            <div class="kk-login-footer">
                <p>Ingen konto?</p>
                <button type="button"
                        class="kk-switch-button"
                        onclick="showRegister()">
                    Opprett bruker
                </button>
            </div>

        </div>

        <!-- Opprett bruker -->
        <div id="kk-register-view" hidden>

            <div class="kk-login-heading">
                <h2>Opprett bruker</h2>
            </div>

            <form class="kk-login-form" onsubmit="return false;">

                <div class="mb-3">
                    <label for="kk-name" class="form-label">
                        Navn
                    </label>
                    <input type="text"
                           class="form-control"
                           id="kk-name"
                           placeholder="Fullt navn"
                           autocomplete="off" />
                </div>

                <div class="mb-3">
                    <label for="kk-register-email" class="form-label">
                        E-postadresse
                    </label>
                    <input type="email"
                           class="form-control"
                           id="kk-register-email"
                           placeholder="navn@eksempel.no"
                           autocomplete="off" />
                </div>

                <div class="mb-3">
                    <label for="kk-register-password" class="form-label">
                        Passord
                    </label>
                    <input type="password"
                           class="form-control"
                           id="kk-register-password"
                           placeholder="Skriv inn passord"
                           autocomplete="off" />
                </div>

                <div class="mb-3">
                    <label for="kk-confirm-password" class="form-label">
                        Bekreft passord
                    </label>
                    <input type="password"
                           class="form-control"
                           id="kk-confirm-password"
                           placeholder="Gjenta passord"
                           autocomplete="off" />
                </div>

                <button type="button"
                        class="kk-login-submit"
                        disabled>
                    Opprett bruker
                </button>
            </form>

            <div class="kk-login-footer">
                <p>Har du allerede en konto?</p>
                <button type="button"
                        class="kk-switch-button"
                        onclick="showLogin()">
                    Logg inn
                </button>
            </div>

        </div>

    </div>
</section>

@section Scripts {
    <script>
        function showRegister() {
            document.getElementById("kk-login-view").hidden = true;
            document.getElementById("kk-register-view").hidden = false;
        }

        function showLogin() {
            document.getElementById("kk-register-view").hidden = true;
            document.getElementById("kk-login-view").hidden = false;
        }
    </script>
}

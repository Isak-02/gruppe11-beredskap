@model List<gruppe11_beredskap.Models.RessursViewModel>
@{
    // "Mine ressurser" bruker samme visning, med egen overskrift fra controlleren
    var overskrift = ViewData["Overskrift"] as string ?? "Registrerte ressurser";
    ViewData["Title"] = overskrift;
}

<h1>@overskrift</h1>
<a asp-action="Registrer" class="btn btn-outline-success mb-3">+ Registrer ny ressurs</a>

@if (!Model.Any())
{
    <p>Ingen ressurser registrert ennå.</p>
}
else
{
    <table class="table table-striped">
        <thead>
        <tr>
            <th>ID</th>
            <th>Type</th>
            <th>Beskrivelse</th>
            <th>Drivstofftype</th>
            <th>Lastekapasitet</th>
            <th>Område</th>
            <th>Tidspunkt</th>
            <th>Kontaktpunkt</th>
            <th>Status</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var ressurs in Model)
        {
            <tr>
                <td>@ressurs.Id.ToString("D4")</td>
                <td>@ressurs.TypeRessurs</td>
                <td>@ressurs.Beskrivelse</td>
                <td>@(ressurs.Drivstofftype ?? "-")</td>
                <td>@(ressurs.Lastekapasitet.HasValue ? $"{ressurs.Lastekapasitet} tonn" : "-")</td>
                <td>@ressurs.GeografiskOmrade</td>
                <td>@ressurs.Tidspunkt.ToString("g")</td>
                <td>@ressurs.Kontaktpunkt</td>
                <td>@ressurs.Status</td>
                <td class="text-nowrap">
                    <a asp-action="Endre" asp-route-id="@ressurs.Id">Endre</a>
                    <form asp-action="Slett" asp-route-id="@ressurs.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Slett</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
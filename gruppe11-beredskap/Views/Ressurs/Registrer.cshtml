@model gruppe11_beredskap.Models.RessursViewModel
@{
    var endrer = Model.Id != 0;
    ViewData["Title"] = endrer ? "Endre ressurs" : "Registrer ressurs";
}

<h1>@(endrer ? "Endre ressurs" : "Registrer ressurs")</h1>

<form asp-action="@(endrer ? "Endre" : "Registrer")" method="post" class="wizard" data-wizard>
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <nav class="wizard-progress" data-wizard-progress aria-label="Fremdrift"></nav>
    <p class="wizard-status" data-wizard-status></p>

    <section class="wizard-panel is-active" data-wizard-panel data-wizard-label="Opplysninger">
        <h2 id="steg-opplysninger">Opplysninger</h2>

        <div class="wizard-chunk">
            <div class="wizard-field">
                <div class="form-label-row">
                    <label asp-for="TypeRessurs" class="form-label"></label>
                    <button type="button" class="hjelp" aria-expanded="false" aria-controls="hjelp-type" aria-label="Hjelp om type">?</button>
                </div>
                <p class="hjelp-tekst" id="hjelp-type" hidden>Velg hvilken type ressurs du kan bidra med.</p>
                <select asp-for="TypeRessurs" class="form-select" id="typeRessursSelect" onchange="toggleAnnetFelt()"
                        data-summary="Type"
                        data-step-required="true"
                        data-step-message="Du må velge type ressurs.">
                    <option value="">Velg type</option>
                    <option>Drone og droneoperatør</option>
                    <option>ATV</option>
                    <option>Traktor</option>
                    <option>Gravemaskin</option>
                    <option>Hjullaster</option>
                    <option>Skogsmaskin</option>
                    <option>Snøskuter</option>
                    <option>Lastebil</option>
                    <option>Henger</option>
                    <option>Sand/grus</option>
                    <option>Aggregat</option>
                    <option>Lokaler</option>
                    <option>Sambandsutstyr</option>
                    <option>Båt</option>
                    <option>Mannskap/frivillige</option>
                    <option value="Annet">Annet</option>
                </select>
                <span asp-validation-for="TypeRessurs" class="text-danger"></span>
            </div>

            <div class="wizard-field" id="annetSteg" hidden>
                <label asp-for="AnnenType" class="form-label"></label>
                <input asp-for="AnnenType" class="form-control" placeholder="Skriv inn type ressurs" maxlength="200"
                       data-summary="Spesifisert type"
                       data-step-required="true"
                       data-step-message="Skriv inn type ressurs." />
                <span asp-validation-for="AnnenType" class="text-danger"></span>
            </div>

            <div class="wizard-field">
                <label asp-for="Beskrivelse" class="form-label"></label>
                <textarea asp-for="Beskrivelse" class="form-control" rows="3" placeholder="Beskriv ressursen"
                          data-summary="Beskrivelse"
                          data-step-required="true"
                          data-step-message="Du må skrive en beskrivelse av ressursen."></textarea>
                <span asp-validation-for="Beskrivelse" class="text-danger"></span>
            </div>

            <div class="wizard-inline">
                <div class="wizard-field" id="drivstoffSteg" hidden>
                    <span class="form-label" id="drivstoff-label">Drivstofftype</span>
                    <div class="wizard-choices" role="radiogroup" aria-labelledby="drivstoff-label"
                         data-choice-group
                         data-summary="Drivstofftype"
                         data-step-required="true"
                         data-step-message="Du må velge drivstofftype for denne ressursen.">
                        <label class="wizard-choice" for="drivstoffBensin">
                            <input type="radio" name="Drivstofftype" id="drivstoffBensin" value="Bensin" @(Model.Drivstofftype == "Bensin" ? "checked" : null) />
                            Bensin
                        </label>
                        <label class="wizard-choice" for="drivstoffDiesel">
                            <input type="radio" name="Drivstofftype" id="drivstoffDiesel" value="Diesel" @(Model.Drivstofftype == "Diesel" ? "checked" : null) />
                            Diesel
                        </label>
                        <label class="wizard-choice" for="drivstoffElektrisk">
                            <input type="radio" name="Drivstofftype" id="drivstoffElektrisk" value="Elektrisk" @(Model.Drivstofftype == "Elektrisk" ? "checked" : null) />
                            Elektrisk
                        </label>
                    </div>
                    <span asp-validation-for="Drivstofftype" class="text-danger"></span>
                </div>

                <div class="wizard-field" id="lastSteg" hidden>
                    <label asp-for="Lastekapasitet" class="form-label"></label>
                    <input asp-for="Lastekapasitet" class="form-control" type="number" min="0.01" max="60" step="0.01"
                           data-summary="Lastekapasitet (tonn)"
                           data-step-required="true"
                           data-step-message="Du må skrive inn en lastekapasitet som er større enn 0."
                           data-step-max="60"
                           data-step-max-message="Lastekapasiteten kan være maks 60 tonn." />
                    <span asp-validation-for="Lastekapasitet" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="wizard-chunk">
            <div class="wizard-field">
                <label asp-for="Kontaktpunkt" class="form-label"></label>
                <input asp-for="Kontaktpunkt" class="form-control" placeholder="Navn og telefon"
                       data-summary="Kontaktpunkt"
                       data-step-required="true"
                       data-step-message="Du må skrive inn et kontaktpunkt." />
                <span asp-validation-for="Kontaktpunkt" class="text-danger"></span>
            </div>
        </div>
    </section>

    <section class="wizard-panel" data-wizard-panel data-wizard-label="Kart" data-wizard-map="true"
             data-step-message="Du må sette en markør på kartet for å velge sted.">
        <h2 id="steg-kart">Hvor på kartet
            <button type="button" class="hjelp" aria-expanded="false" aria-controls="hjelp-kart" aria-label="Hjelp om kartet">?</button>
        </h2>
        <p class="hjelp-tekst" id="hjelp-kart" hidden>Klikk i kartet for å sette markør.</p>
        <div id="map"></div>
        <input type="hidden" asp-for="Latitude" id="latitude" data-wizard-lat />
        <input type="hidden" asp-for="Longitude" id="longitude" />
        <input type="hidden" asp-for="GeografiskOmrade" id="geografiskOmrade" />
        <p id="valgtStedTekst" class="text-muted mt-2 mb-0">Ingen posisjon valgt ennå</p>
        <span asp-validation-for="Latitude" class="text-danger"></span>
    </section>

    <section class="wizard-panel" data-wizard-panel data-wizard-label="Oversikt" data-wizard-summary="true">
        <h2 id="steg-oversikt">Oversikt</h2>
        <dl class="wizard-summary" data-wizard-summary-list></dl>
    </section>

    <div class="wizard-actions">
        <p class="wizard-error text-danger" data-wizard-error hidden></p>
        <div class="wizard-buttons">
            <button type="button" class="btn btn-outline-primary" data-wizard-back hidden>Tilbake</button>
            <button type="button" class="btn btn-primary" data-wizard-next>Neste</button>
            <button type="submit" class="btn btn-primary" data-wizard-submit hidden>@(endrer ? "Lagre endringer" : "Registrer ressurs")</button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        function toggleAnnetFelt() {
            var select = document.getElementById("typeRessursSelect");
            var annetSteg = document.getElementById("annetSteg");
            var drivstoffSteg = document.getElementById("drivstoffSteg");
            var lastSteg = document.getElementById("lastSteg");

            var visAnnet = select.value === "Annet";
            annetSteg.hidden = !visAnnet;

            if (!visAnnet) {
                document.getElementById("AnnenType").value = "";
            }

            var kjøretøyOgMaskiner = [
                "Drone og droneoperatør",
                "ATV",
                "Traktor",
                "Gravemaskin",
                "Hjullaster",
                "Skogsmaskin",
                "Snøskuter",
                "Lastebil",
                "Aggregat",
                "Båt"
            ];

            var trengerDrivstoff = kjøretøyOgMaskiner.includes(select.value);
            drivstoffSteg.hidden = !trengerDrivstoff;

            if (!trengerDrivstoff) {
                drivstoffSteg.querySelectorAll("input[type=radio]").forEach(function (input) {
                    input.checked = false;
                });
            }

            var ressurserMedLastekapasitet = [
                "Henger",
                "Traktor",
                "Gravemaskin",
                "Hjullaster",
                "Skogsmaskin",
                "Lastebil"
            ];

            var trengerLastekapasitet = ressurserMedLastekapasitet.includes(select.value);
            lastSteg.hidden = !trengerLastekapasitet;

            if (!trengerLastekapasitet) {
                document.getElementById("Lastekapasitet").value = "";
            }

            select.form.dispatchEvent(new CustomEvent("wizard:refresh"));
        }

        document.addEventListener("DOMContentLoaded", toggleAnnetFelt);
        toggleAnnetFelt();

        var ressursKart = null;

        function startRessursKart() {
            if (ressursKart) {
                window.setTimeout(function () { ressursKart.invalidateSize(); }, 0);
                return;
            }

            var map = L.map('map').setView([58.1467, 7.9956], 13);
            ressursKart = map;

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
            }).addTo(map);

            // Gruppe som holder markøren brukeren har satt
            var tegnedeFigurer = new L.FeatureGroup();
            map.addLayer(tegnedeFigurer);

            // Norske tekster i verktøylinjen.
            L.drawLocal.draw.toolbar.actions.title = "Avbryt tegning";
            L.drawLocal.draw.toolbar.actions.text = "Avbryt";
            L.drawLocal.draw.toolbar.buttons.marker = "Sett en markør";
            L.drawLocal.draw.handlers.marker.tooltip.start = "Klikk på kartet for å sette markøren.";
            L.drawLocal.edit.toolbar.actions.save.title = "Lagre endringene";
            L.drawLocal.edit.toolbar.actions.save.text = "Lagre";
            L.drawLocal.edit.toolbar.actions.cancel.title = "Avbryt redigering og forkast endringene";
            L.drawLocal.edit.toolbar.actions.cancel.text = "Avbryt";
            L.drawLocal.edit.toolbar.actions.clearAll.title = "Slett alle figurer";
            L.drawLocal.edit.toolbar.actions.clearAll.text = "Slett alle";
            L.drawLocal.edit.toolbar.buttons.edit = "Rediger";
            L.drawLocal.edit.toolbar.buttons.editDisabled = "Ingenting å redigere";
            L.drawLocal.edit.toolbar.buttons.remove = "Slett";
            L.drawLocal.edit.toolbar.buttons.removeDisabled = "Ingenting å slette";
            L.drawLocal.edit.handlers.edit.tooltip.text = "Dra i figuren for å flytte eller endre den.";
            L.drawLocal.edit.handlers.edit.tooltip.subtext = "Klikk Avbryt for å angre endringene.";
            L.drawLocal.edit.handlers.remove.tooltip.text = "Klikk på figuren for å slette den.";

            // Verktøylinje på kartet: markør, rediger og slett (ingen sirkel for ressurs)
            var tegneverktøy = new L.Control.Draw({
                draw: {
                    polygon: false,
                    polyline: false,
                    rectangle: false,
                    circlemarker: false,
                    circle: false,
                    marker: true
                },
                edit: {
                    featureGroup: tegnedeFigurer,
                    remove: true
                }
            });
            map.addControl(tegneverktøy);

            var latInput = document.getElementById('latitude');

            function varsleSkjema() {
                latInput.dispatchEvent(new Event("input", { bubbles: true }));
            }

            // Fyller skjemafeltene med posisjonen til markøren
            function oppdaterPosisjon(layer) {
                var latlng = layer.getLatLng();
                var lat = latlng.lat;
                var lng = latlng.lng;

                latInput.value = lat;
                document.getElementById('longitude').value = lng;
                document.getElementById('geografiskOmrade').value = lat.toFixed(5) + ", " + lng.toFixed(5);

                document.getElementById('valgtStedTekst').textContent = "Valgt posisjon: " + lat.toFixed(5) + ", " + lng.toFixed(5);
                document.getElementById('valgtStedTekst').classList.remove('text-muted');
                document.getElementById('valgtStedTekst').classList.add('text-success');
                varsleSkjema();
            }

            // Tømmer skjemafeltene når figuren slettes
            function tomPosisjon() {
                latInput.value = '';
                document.getElementById('longitude').value = '';
                document.getElementById('geografiskOmrade').value = '';

                document.getElementById('valgtStedTekst').textContent = "Ingen posisjon valgt ennå";
                document.getElementById('valgtStedTekst').classList.remove('text-success');
                document.getElementById('valgtStedTekst').classList.add('text-muted');
                varsleSkjema();
            }

            // Ny figur tegnet. Bare én figur om gangen, så den forrige fjernes først.
            map.on('draw:created', function (e) {
                var layer = e.layer;

                tegnedeFigurer.clearLayers();
                tegnedeFigurer.addLayer(layer);
                oppdaterPosisjon(layer);
            });

            // Figuren er flyttet med rediger-verktøyet
            map.on('draw:edited', function (e) {
                e.layers.eachLayer(function (layer) {
                    oppdaterPosisjon(layer);
                });
            });

            // Figuren er slettet med slett-verktøyet
            map.on('draw:deleted', function () {
                tomPosisjon();
            });

            // Ved valideringsfeil kommer siden tilbake med posisjonen i de skjulte feltene.
            // Da settes markøren på kartet igjen, slik at brukeren ser den og kan flytte eller slette den.
            var lagretLat = latInput.value;
            var lagretLng = document.getElementById('longitude').value;

            if (lagretLat && lagretLng) {
                var lagretMarkor = L.marker([Number(lagretLat), Number(lagretLng)]);

                tegnedeFigurer.addLayer(lagretMarkor);
                oppdaterPosisjon(lagretMarkor);
            }

            window.addEventListener("resize", function () {
                map.invalidateSize();
            });

            window.setTimeout(function () { map.invalidateSize(); }, 0);
            window.setTimeout(function () { map.invalidateSize(); }, 200);
        }

        var skjema = document.querySelector("[data-wizard]");
        skjema.addEventListener("wizard:shown", function (e) {
            if (e.target.querySelector("#map")) startRessursKart();
        });
        if (document.querySelector(".wizard-panel.is-active #map")) startRessursKart();
    </script>
}
